{
    "name": "nova-kit/nova-packages-tool",
    "description": "Tool for Laravel Nova Packages Development",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mior Muhammad Zaki",
            "email": "crynobone@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "NovaKit\\NovaPackagesTool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.48.23|^11.35|^12.0"
    },
    "require-dev": {
        "laravel/nova": "^5.3",
        "laravel/nova-devtool": "^1.7",
        "laravel/pint": "^1.20",
        "orchestra/pest-plugin-testbench": "^2.0|^3.0"
    },
    "conflict": {
        "laravel/nova": "<5.3.0|>=6.0.0"
    },
    "repositories": [
        { "type": "composer", "url": "https://nova.laravel.com" }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "NovaKit\\NovaPackagesTool\\LaravelServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "nova:build": [
            "npm ci",
            "TAILWIND_MODE=build npm run prod"
        ],
        "lint": [
            "pint"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
